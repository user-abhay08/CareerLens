# ── CareerLens server configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your FREE API key (only one is needed).

# ── Option 1: Google Gemini (recommended, free tier) ────────────────────────
# Get a key in 1 minute: https://aistudio.google.com/app/apikey (keys start with "AIza…")
# IMPORTANT: copy this file to server/.env and put your key THERE — this
# template is not read by the app. Restart the server after editing .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Option 2: Groq (free tier, OpenAI-compatible) ───────────────────────────
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Option 3: OpenRouter (free models, OpenAI-compatible) ───────────────────
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── General ─────────────────────────────────────────────────────────────────
PORT=5000
# Leave empty to auto-start a throwaway in-memory MongoDB (dev convenience).
# For real persistence use MongoDB Atlas free tier:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/careerlens
MONGODB_URI=
JWT_SECRET=fajdfjsdfljlfjaslfoewfnslflfdlfjfjefeoiwiljdkieldkjf
CLIENT_ORIGIN=http://localhost:5173

# ── Social sign-in (OPTIONAL — buttons appear on login/register either way) ─
# GOOGLE (free, ~5 min):
#   1. console.cloud.google.com → create project → "OAuth consent screen"
#      (External → add your own email as test user)
#   2. Credentials → Create credentials → OAuth client ID → Web application
#   3. Authorized JavaScript origins: http://localhost:5173
#   4. Copy the client ID (ends in .apps.googleusercontent.com) below and
#      restart the server.
GOOGLE_CLIENT_ID=
# APPLE (requires a paid Apple Developer account):
#   Apple Developer → Identifiers → register a Services ID with
#   "Sign In with Apple", create a Sign in with Apple key, then set the
#   Services ID here.
APPLE_CLIENT_ID=

# ── Live job listings (OPTIONAL — all free) ─────────────────────────────────
# With none configured, the Career Matches page falls back to one-click
# apply links into LinkedIn / Naukri / Indeed searches, plus live remote
# jobs from Remotive (no key needed).
# JSearch via RapidAPI — aggregates REAL LinkedIn / Indeed / Glassdoor
# postings. Free tier at https://rapidapi.com (search "JSearch" → subscribe
# to the free plan → copy your key).
RAPIDAPI_KEY=
# Adzuna — India-focused listings. Free app_id + app_key at
# https://developer.adzuna.com (register → create an app).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
